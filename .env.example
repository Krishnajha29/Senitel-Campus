# ==============================================================================
# Sentinel Campus Environment Variables Configuration (.env.example)
# ==============================================================================

# Supabase Project URL (replace with your project URL from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Client Key (Safe for frontend exposure, governed by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Base Application URL for QR Code Mobile Generation
# When testing with physical smartphone cameras on the local Wi-Fi network, set to your machine's LAN IP
# Example: http://192.168.1.100:5173 or https://campus.sentinel.edu
VITE_APP_URL=http://localhost:5173

# Optional: Set to true to force offline sandbox mode regardless of Supabase credentials
# VITE_ENABLE_MOCK_STORAGE=false
