# ==============================================================================
# Sentinel Campus Environment Variables Configuration (.env.example)
# Vercel Multi-Service Deployment (Frontend + FastAPI CV Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND SERVICE ("app" - Vite)
# ------------------------------------------------------------------------------

# Supabase Project URL (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Client Key (Safe for frontend exposure, governed by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Base Application URL for QR Code Mobile Generation
# In local development: http://localhost:5173 or your LAN IP (e.g., http://192.168.1.100:5173)
# In production on Vercel: https://your-production-app.vercel.app
VITE_APP_URL=https://your-production-app.vercel.app

# Sentinel Campus Mobile Backend API URL (Express backend for live QR student-by-student capture)
# Example: https://elk-refund-fifty.ngrok-free.dev or http://localhost:5000
VITE_MOBILE_API_BASE_URL=https://elk-refund-fifty.ngrok-free.dev

# Optional: Set to true to force offline sandbox mode regardless of Supabase credentials
# VITE_ENABLE_MOCK_STORAGE=false

# ------------------------------------------------------------------------------
# 2. BACKEND SERVICE ("cv_service" - FastAPI Computer Vision Engine)
# ------------------------------------------------------------------------------

# Allowed CORS Origins (comma-separated, default is "*" for development and preview deployments)
# Example: https://your-production-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Optional: Server Port for local development (default 8000)
PORT=8000

# Optional: Detection model for dlib ("hog" for CPU/Serverless, "cnn" for GPU)
CV_DETECTION_MODEL=hog
