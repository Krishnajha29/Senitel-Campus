{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "cv_service": {
      "root": "cv_service",
      "framework": "fastapi",
      "entrypoint": "face_engine:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/cv/:path*",
      "destination": {
        "service": "cv_service"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "cv_service"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
